# copy to .env next to docker-compose.yml; never commit .env
POAC_PUBLIC_HOST=poac.example.org
# openssl rand -hex 32
POAC_SERVER_SECRET=
POAC_LEAN_MAX_MEMORY_MB=1024
# leave empty until a corpus has been built with `poac-corpus` and copied
# into the poac-data volume; then: /data/corpus.sqlite
POAC_CORPUS_DB=
# /play human-trial telemetry (JSONL, anonymous). Empty = memory only.
POAC_TRIALS_LOG=/data/human-trials.jsonl
# Issuer key. Preferred: AWS KMS (run deploy/aws-kms-setup.sh; it prints
# the POAC_KMS_* / AWS_* lines). Without KMS, sign with a key file on the
# volume instead:  POAC_ISSUER_KEY_ARGS=--issuer-key-file /data/issuer.jwk
# During a local→KMS switch set both; after one receipt TTL remove the
# file args and the file (keep the deploy/backup-secrets.sh bundle).
POAC_ISSUER_KEY_ARGS=
POAC_KMS_REGION=
POAC_KMS_ED25519_KEY=
POAC_KMS_MLDSA65_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
