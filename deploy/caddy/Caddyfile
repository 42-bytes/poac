# Reverse proxy for the PoAC verifier. TLS via ACME DNS-01 against the
# Route 53 zone that holds POAC_PUBLIC_HOST, using the scoped `poac-dns01`
# IAM user (deploy/aws-failover-setup.sh). Env: POAC_PUBLIC_HOST,
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION, POAC_DNS_ZONE_ID.
{$POAC_PUBLIC_HOST} {
	tls {
		dns route53 {
			# {$VAR} is substituted when the Caddyfile is parsed; the module
			# does not expand runtime {env.*} placeholders for hosted_zone_id
			access_key_id {$AWS_ACCESS_KEY_ID}
			secret_access_key {$AWS_SECRET_ACCESS_KEY}
			region {$AWS_REGION}
			hosted_zone_id {$POAC_DNS_ZONE_ID}
		}
	}
	encode zstd gzip
	reverse_proxy verifier:8000
}
